page { background: #f4f5f7; color: #24272d; font-size: 14px; font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; }
.page { min-height: 100vh; padding: 12px 16px 32px; box-sizing: border-box; }
.card { background: #fff; border-radius: 18rpx; }
.btn-primary { background: #6c4ce8; color: #fff; border-radius: 14rpx; text-align: center; font-weight: 600; }
.sec-title { display: flex; justify-content: space-between; align-items: center; margin: 22rpx 4rpx 16rpx; }
.sec-title text { font-size: 34rpx; font-weight: 700; color: #24272d; }
.muted { color: #8b9199; font-size: 24rpx; }
