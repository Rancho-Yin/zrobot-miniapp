<view class="page">
  <view class="hero">
    <image class="hero-logo" src="/assets/logo.png"/>
    <text class="hero-title">想创作什么？</text>
    <text class="hero-sub">描述想法，或添加参考图。</text>
  </view>
  <view wx:if="{{showTpl}}" class="tpls">
    <view class="tpl" wx:for="{{themes}}" wx:key="id" bindtap="useTheme" data-id="{{item.id}}">
      <image class="tpl-img" src="{{item.img}}" mode="aspectFill"/>
      <text class="tpl-name">{{item.title}}</text>
    </view>
  </view>
  <view class="tools-bar"><view class="tpl-btn" bindtap="toggleTpl">模板</view><text class="credit">{{credits}} 积分</text></view>
  <view class="composer">
    <textarea class="input" value="{{input}}" placeholder="描述你想生成的画面…" maxlength="200" bindinput="onInput" auto-height/>
    <view class="tools">
      <view class="tool" bindtap="upload">+</view>
      <view class="tool" bindtap="pickModel">{{modelName}} ▾</view>
      <text class="cost">2 积分/次</text>
      <view class="gap"></view>
      <view class="tool" bindtap="mic">语音</view>
      <view class="send {{input ? 'on' : ''}}" bindtap="send">↑</view>
    </view>
  </view>
</view>
