<view class="page">
  <view class="toolbar">
    <view class="search"><text class="ico">⌕</text><input placeholder="搜索" value="{{query}}" bindinput="onSearch"/></view>
    <view class="up">↑</view>
  </view>
  <view class="filters">
    <text class="f {{filter === 'all' ? 'on' : ''}}" bindtap="setFilter" data-v="all">全部</text>
    <text class="f {{filter === 'image' ? 'on' : ''}}" bindtap="setFilter" data-v="image">图片</text>
    <text class="f {{filter === 'video' ? 'on' : ''}}" bindtap="setFilter" data-v="video">视频</text>
  </view>
  <view class="grid" wx:if="{{works.length}}">
    <view class="card" wx:for="{{works}}" wx:key="id" bindtap="tapWork" data-id="{{item.id}}">
      <view class="cover-wrap">
        <video wx:if="{{item.type === 'video'}}" class="cover" src="{{item.url}}" object-fit="cover" muted show-center-play-btn="{{false}}"/>
        <image wx:else class="cover" src="{{item.imageUrl || item.url}}" mode="aspectFill"/>
        <text class="tag">{{item.tag}}</text>
      </view>
      <text class="title">{{item.title}}</text>
      <text class="meta">{{item.tag}} · {{item.scene || '自由创作'}} · {{item.date}}</text>
    </view>
  </view>
  <view wx:else class="empty"><image class="brand" src="/assets/logo.png"/><text>暂无内容</text></view>
  <view wx:if="{{undo}}" class="snackbar"><text>已删除「{{undo.work.title}}」</text><text class="undo" bindtap="undo">撤销</text></view>
</view>
