.account { display: flex; align-items: center; gap: 22rpx; padding: 20rpx 4rpx 26rpx; }
.ava { width: 96rpx; height: 96rpx; border-radius: 50%; background: #eceef1; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.acc { flex: 1; }
.name { display: block; font-size: 34rpx; font-weight: 700; }
.sub { display: block; margin-top: 4rpx; font-size: 23rpx; color: #8b9199; }
.chev { color: #b8bdc5; font-size: 32rpx; }
.cr-card { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; border-radius: 32rpx; background: linear-gradient(135deg, #8848f5, #6d28d9); color: #fff; }
.cr-copy .cl { font-size: 22rpx; opacity: .82; }
.cr-copy .cv { display: block; font-size: 52rpx; font-weight: 700; margin: 4rpx 0; }
.cr-copy .cp { font-size: 21rpx; opacity: .78; }
.cr-btn { background: #fff; color: #6d28d9; font-size: 26rpx; font-weight: 600; border-radius: 999rpx; padding: 0 34rpx; line-height: 68rpx; }
.rows { margin-top: 26rpx; background: #fff; border-radius: 28rpx; overflow: hidden; }
.row { display: flex; align-items: center; gap: 18rpx; padding: 30rpx 26rpx; border-bottom: 1rpx solid #f0f1f4; font-size: 28rpx; color: #2b3035; }
.row:last-child { border-bottom: 0; }
.row .chev { margin-left: auto; }
.note { display: block; text-align: center; margin-top: 40rpx; font-size: 21rpx; color: #a4aab2; }
